{
  "manifest_version": 3,
  "name": "Encode Companion — 1-Click Slides & Gemini to Anki",
  "version": "1.2.0",
  "description": "Zero-friction flashcard companion for DeepEncode: Capture Google Slides, Gemini chat, or any webpage into Anki & RemNote.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Encode Companion"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/presentation/*"],
      "js": ["content/google-slides.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://docs.google.com/presentation/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "<all_urls>"
  ]
}
